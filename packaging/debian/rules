#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_HOME = $(CURDIR)/debian/.cargo
export RUSTUP_HOME = $(CURDIR)/debian/.rustup
export PATH := $(CARGO_HOME)/bin:$(PATH)

ensure_rust_toolchain = \
	mkdir -p -m 0700 "$(CARGO_HOME)" "$(RUSTUP_HOME)"; \
	if ! command -v rustc >/dev/null 2>&1 || ! command -v cargo >/dev/null 2>&1; then \
		echo "ERROR: rustc and cargo must be installed in the build environment" >&2; \
		exit 1; \
	fi; \
	if [ "$$(rustc -V | sed -E 's/rustc [0-9]+\.([0-9]+)\..*/\1/')" -lt 90 ]; then \
		echo "ERROR: rustc version >= 1.90 is required (found $$(rustc -V))" >&2; \
		exit 1; \
	fi

%:
	dh $@

override_dh_auto_clean:
	rm -rf target "$(CARGO_HOME)" "$(RUSTUP_HOME)"

override_dh_auto_build:
	$(ensure_rust_toolchain)
	$(MAKE) build

override_dh_auto_test:
	$(ensure_rust_toolchain)
	$(MAKE) check

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/ultradesk-rust

override_dh_dwz:
	@echo "Skipping dh_dwz (incompatible with mixed Rust debug sections)"
