#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_HOME = /tmp/ultradesk-cargo
export RUSTUP_HOME = /tmp/ultradesk-rustup
export PATH := /tmp/ultradesk-cargo/bin:$(PATH)

ensure_rust_toolchain = \
	if ! command -v rustc >/dev/null 2>&1 || [ "$$(rustc -V | sed -E 's/rustc [0-9]+\.([0-9]+)\..*/\1/')" -lt 90 ]; then \
		curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path; \
	fi

%:
	dh $@

override_dh_auto_build:
	$(ensure_rust_toolchain)
	$(MAKE) build

override_dh_auto_test:
	$(ensure_rust_toolchain)
	$(MAKE) check

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/ultradesk-rust

override_dh_dwz:
	@echo "Skipping dh_dwz (incompatible with mixed Rust debug sections)"
