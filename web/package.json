{
  "name": "ultradesk-viewer",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production && node scripts/bundle-singlefile.mjs",
    "build:ng": "ng build --configuration production",
    "bundle": "node scripts/bundle-singlefile.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,html}\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "^10.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
