pkgname=ultradesk-rust
pkgver=1.0.8
pkgrel=1
pkgdesc="Remote desktop controller and host for Linux (Rust Edition)"
arch=('x86_64')
url="https://github.com/dtrh95/ultradesk"
license=('MIT')
options=('!lto')
depends=(
  'gcc-libs'
  'openssl'
  'libxcb'
  'zstd'
  'gtk3'
  'webkit2gtk-4.1'
  'libsoup3'
)
makedepends=(
  'cargo'
  'pkgconf'
  'gtk3'
  'webkit2gtk-4.1'
  'libsoup3'
)
_source_sha256="${ULTRADESK_SOURCE_SHA256:-}"

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
if [ -n "${_source_sha256}" ]; then
  sha256sums=("${_source_sha256}")
else
  sha256sums=('SKIP')
fi

prepare() {
  if [ -z "${ULTRADESK_SOURCE_SHA256:-}" ] && [ "${ULTRADESK_ALLOW_UNVERIFIED_SOURCE:-0}" != "1" ]; then
    echo "ERROR: ULTRADESK_SOURCE_SHA256 environment variable is required to verify source tarball integrity." >&2
    echo "To allow unverified local builds, set ULTRADESK_ALLOW_UNVERIFIED_SOURCE=1." >&2
    return 1
  fi
  cd "${srcdir}/ultradesk-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/ultradesk-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  make build
}

check() {
  cd "${srcdir}/ultradesk-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export ULTRADESK_DISABLE_SYSTEM_CLIPBOARD=1
  make check
}

package() {
  cd "${srcdir}/ultradesk-${pkgver}"
  make install PREFIX=/usr DESTDIR="${pkgdir}"
}
