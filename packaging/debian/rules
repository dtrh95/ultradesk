#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	$(MAKE) build

override_dh_auto_test:
	$(MAKE) check

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/ultradesk-rust

override_dh_dwz:
	@echo "Skipping dh_dwz (incompatible with mixed Rust debug sections)"
